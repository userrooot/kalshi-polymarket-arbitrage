# Copy to .env and adjust. Simulation only: no orders are ever sent.

# Max combined cost (cents) of the two legs of an arbitrage combo.
# A combo is tradable only when kalshiAsk + polyAsk < MAX_TOTAL_COST.
MAX_TOTAL_COST=90

# Number of contracts bought on each leg per simulated trade.
CONTRACTS_PER_TRADE=10

# Maximum simulated trades per 15-minute event window.
MAX_TRADES_PER_EVENT=20

# Minimum time between two trades, in milliseconds.
TRADE_COOLDOWN_MS=5000

# Do not open new trades in the last N seconds before an event closes.
NO_TRADE_LAST_SEC=20

# How often markets and BTC price are polled, in milliseconds.
POLL_MS=1000

# HTTP and WebSocket port for the dashboard.
PORT=3000

# Dashboard bind address. Keep 127.0.0.1: the dashboard has no login.
# On a server, reach it through an SSH tunnel (see README, "Deploy to the UK VPS").
HOST=127.0.0.1

# SQLite file where simulated trades and stats are stored (relative to the repo root).
DB_PATH=data/sim.sqlite

# Maximum age of a venue quote, in milliseconds, before it is treated as stale.
MAX_QUOTE_AGE_MS=3000

# How often the Kalshi order book is polled over REST, in milliseconds.
# Used unless a Kalshi websocket with an API key is configured.
KALSHI_BOOK_POLL_MS=350

# Kalshi REST API base URL (public market data, no auth needed).
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Polymarket Gamma API (market discovery) base URL.
POLY_GAMMA_URL=https://gamma-api.polymarket.com

# Polymarket CLOB API (order book / prices) base URL.
POLY_CLOB_URL=https://clob.polymarket.com

# ---------------------------------------------------------------------------
# Authenticated websockets (optional, strongly recommended)
# Without a Kalshi key the Kalshi spot panel shows "no official feed" and no estimate is used.
# Polymarket spot still works without keys (plain Chainlink, not TWAP).
# Secrets are never logged. Keep .env and *.pem files out of git (both are in .gitignore).
# ---------------------------------------------------------------------------

# Kalshi API key ID. REQUIRED for the Kalshi spot: the official CF Benchmarks BRTI index
# (cfbenchmarks_value, 5Hz) is streamed over the Kalshi websocket. Also unlocks pushed order
# book updates for Up/Down prices, replacing REST polling. Needs a private key (below).
# KALSHI_API_KEY_ID=

# Path to the RSA private key PEM file for the Kalshi API key. Used to sign websocket login.
# KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Alternative to KALSHI_PRIVATE_KEY_PATH: the PEM inline on one line, with newlines written as \n.
# KALSHI_PRIVATE_KEY=

# Kalshi authenticated websocket URL. Only change this if Kalshi moves its endpoint.
# KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2

# Polymarket CLOB API key, secret and passphrase. Unlock the authenticated CLOB user/market
# websocket and the live-data stream used for the Chainlink 60s TWAP (Polymarket's resolution source).
# POLY_API_KEY=
# POLY_API_SECRET=
# POLY_API_PASSPHRASE=

# Polymarket live-data websocket URL (Chainlink BTC/USD and 60s TWAP). Only change if Polymarket moves it.
# POLY_LIVE_WS_URL=wss://ws-live-v2.polymarket.com/ws

# ---------------------------------------------------------------------------
# Execution realism & UK colocation study (see README). Simulation only.
# Models fills at the book as it is when an order would arrive, not at the instant top-of-book.
# ---------------------------------------------------------------------------

# 1 = run the execution simulator and show its dashboard section. 0 = off (section hidden).
EXEC_SIM=1

# Strategy whose fills drive the headline PnL: NAIVE (instant fill, baseline), PAR (both legs at once),
# K_THEN_P (Kalshi first, Polymarket after its ack) or P_THEN_K (Polymarket first, Kalshi after its ack).
EXEC_PRIMARY=NAIVE

# Extra price ticks above the observed ask that a leg may walk when it fills.
SLIPPAGE_TICKS=1

# Levels that change within this many ms before arrival count as already taken by someone else.
RACE_WINDOW_MS=2

# Extra probability that an order is lost to a race when the opportunity died within 20 ms of arrival.
# This is a guess, so replay reports a range of values.
P_LOSE_RACE=0.3

# What happens to a leg that filled while the other did not: bid = sell it at the bid, hold = keep to settlement.
UNWIND_MODE=bid

# Milliseconds to wait after a one-leg fill before unwinding it.
UNWIND_AFTER_MS=500

# 1 = include estimated taker fees (formulas unverified). 0 = no fees.
FEES_ON=0

# Minutes of full order book depth kept per market for the simulator.
BOOK_HISTORY_MIN=20

# Latency profile written by `bun run probe`. A missing file falls back to assumed default latencies.
LAT_PROFILE=data/latency.json

# Optional what-if overrides, in ms, for one-way latency. Leave unset to use the profile.
# LAT_KALSHI_MS=90
# LAT_POLY_MS=6

# Optional seed for the simulator's random draws, so runs can be reproduced.
# EXEC_SEED=12345

# 1 = record raw market data (both timestamps) to MD_DIR for replay. Needs disk space.
RECORD_MD=0

# Directory for recorded market data files.
MD_DIR=data/md

# Recorder deletes the oldest files once this many GB are used.
MD_RETENTION_GB=20

# Kalshi demo environment (mock funds), used by `bun run probe` for order round trips. Optional.
# KALSHI_DEMO_API_KEY_ID=
# KALSHI_DEMO_PRIVATE_KEY_PATH=./kalshi_demo_private_key.pem
# KALSHI_DEMO_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2

# ---------------------------------------------------------------------------
# !!! REAL MONEY WARNING !!!
# CALIBRATE_LIVE=1 places REAL orders on Kalshi and Polymarket with your real account,
# after a typed confirmation. They are sized and priced to not fill, but a sudden price move could
# fill them. Leave this at 0 unless you have read the README section on calibration.
# Never leaves resting orders. At most one probe every 10 seconds.
# ---------------------------------------------------------------------------
CALIBRATE_LIVE=0
