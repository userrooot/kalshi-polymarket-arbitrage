{
  "name": "kalshi-polymarket-arbitrage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit",
    "probe": "bun run src/exec/probe.ts",
    "replay": "bun run src/exec/replay.ts",
    "record": "RECORD_MD=1 bun run src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
